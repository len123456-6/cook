# =============================================================================
#  FastAPI 应用配置示例
#  用法：Create a copy -> 改名为 .env，本地按需覆盖
# =============================================================================

# --- 应用 ---
APP_NAME=AI 智能食谱买菜平台
ENV=development                  # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- 数据库（相对路径基于项目根目录）---
DATABASE_URL=sqlite:///./data/cook.db
SQL_ECHO=false                   # true 时把 SQLAlchemy 生成的 SQL 打到日志

# --- 安全 ---
# 生产环境务必替换：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS（前端本地开发地址，逗号分隔）---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI 服务：DeepSeek（OpenAI 兼容协议）---
# 密钥申请：https://platform.deepseek.com/api_keys
# ⚠ 只填在 .env（已被 .gitignore 忽略），不要提交到仓库、不要写进代码
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
